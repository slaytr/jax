node_modules/

# Local preview / tooling artefacts. Root-level only — assets/icons/*.png are
# committed on purpose.
/*.png
.playwright-mcp/

# Postgres is canonical now (see the Postgres migration plan) — these are
# only ever local inspection artefacts of scripts/update.mjs /
# quest-data/fetch-quests.mjs run without --to-db, never committed again.
/data/latest.json
/data/history/
/quest-data/quests.json

# Local dev env vars (DATABASE_URL for a local Postgres, optionally Discord
# OAuth creds) — see .env.local.example.
.env.local

# Vite build output for web/ (the Vue frontend) — regenerated by `npm run
# build`, never committed; api/server.mjs serves it once built locally/in CI.
/web/dist/
