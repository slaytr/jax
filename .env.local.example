# Copy this to .env.local (gitignored) for local dev. Loaded via Node's
# --env-file flag (see package.json's :local scripts) — never committed,
# since a real one might point at credentials you don't want in git.

# Matches docker-compose.yml's defaults — port 5433, not Postgres's usual
# 5432 (see that file's own comment for why). If you're running a native
# local Postgres instead, point this at that — and keep ?sslmode=disable
# either way: api/db.mjs only skips TLS when it sees that in the
# connection string, and neither docker-compose's Postgres nor most local
# installs have SSL configured at all.
DATABASE_URL=postgresql://jax:jax@localhost:5433/jax_dev?sslmode=disable

# Only needed if you're also testing Discord sign-in locally — see the
# README's Setup section for how to register an app. Not needed for
# npm run sync:prod, which only touches the database.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:4173/auth/discord/callback
# SESSION_SECRET=
