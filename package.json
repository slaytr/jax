{
  "name": "jax-hiscores",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres-backed scoreboard and API for the Jax group ironman team, fed by the RuneScape 3 hiscores.",
  "scripts": {
    "update": "node scripts/update.mjs",
    "update:db": "node api/jobs/update-job.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "stats": "node scripts/build-stats-pages.mjs",
    "serve": "node scripts/serve.mjs",
    "server": "node api/server.mjs",
    "test": "node --test test/*.test.mjs && vitest run",
    "migrate": "node api/migrate.mjs",
    "backfill": "node scripts/backfill.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate:local": "node --env-file=.env.local api/migrate.mjs",
    "sync:prod": "node --env-file=.env.local scripts/sync-from-prod.mjs",
    "server:local": "node --env-file=.env.local api/server.mjs",
    "build": "vite build",
    "web:dev": "vite",
    "web:preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/static": "^10.1.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "fastify": "^5",
    "pg": "^8",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.12.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
